# Runtime
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/schedule

# Telegram Mini App and bot (required)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_ENV=prod
WEB_APP_URL=http://127.0.0.1:3000/auth

# VK Mini Apps signature validation (required)
VK_CLIENT_SECRET=

# Bitrix schedule source (credentials are required)
BITRIX_URL=https://portal.midis.info/
BITRIX_LOGIN=
BITRIX_PASSWORD=

# oRPC. Leave commented to use the built-in /rpc defaults.
# NEXT_PUBLIC_ORPC_URL=http://127.0.0.1:3000/rpc
# SERVER_ORPC_URL=http://127.0.0.1:3000/rpc

# S3-compatible storage. Set all four values to enable uploads.
# S3_BUCKET=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Standalone reverse proxy
PROXY_TARGET=https://portal.midis.info
PORT=3000
PROXY_PORT=3000

# Test data and clock controls
TESTING_GROUP_ENABLED=false
TEST_TIME_OFFSET_HOURS=0
NEXT_PUBLIC_TEST_TIME_OFFSET_HOURS=0
